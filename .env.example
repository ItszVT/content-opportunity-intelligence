# --- TMDB ---
# Free Developer key. Bearer token preferred over api_key param.
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# --- Wikipedia Pageviews ---
# Keyless, but a descriptive User-Agent is required by their policy.
# Format: project-name/version (contact-url-or-email)
WIKI_USER_AGENT=content-opportunity-intelligence/1.0 (https://github.com/itszv1/content-opportunity-intelligence)

# --- Paths (optional overrides) ---
DATA_DIR=data
WAREHOUSE_PATH=data/warehouse.duckdb
CACHE_DIR=data/raw/cache
